+     */
+    fun toggleTrackFlag(row: RowView, flag: String) {
+        val lanes = timeline?.rows?.filter { it.kind == row.kind }.orEmpty()
+        if (lanes.isEmpty()) return
+        val next = if (flag == "muted") !row.muted else !row.visible
+        lanes.forEach { lane ->
+            command(JSONObject().put("op", "setTrackFlag").put("trackId", lane.trackId).put("flag", flag).put("value", next))
+        }
+        message = when {
