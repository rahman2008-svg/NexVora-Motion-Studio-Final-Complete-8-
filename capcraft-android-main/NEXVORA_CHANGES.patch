+/** The export's progress as a ring: a track, an arc swept as far as the share done, and the percent inside. */
+@Composable
+private fun ProgressRing(progress: Float, modifier: Modifier) {
+    val sweep = progress.coerceIn(0f, 1f)
+    Box(modifier, contentAlignment = Alignment.Center) {
+        androidx.compose.foundation.Canvas(Modifier.fillMaxSize()) {
+            val stroke = 14.dp.toPx()
+            val inset = stroke / 2f
+            val box = androidx.compose.ui.geometry.Size(size.width - stroke, size.height - stroke)
+            drawArc(
+                Palette.Divider, -90f, 360f, useCenter = false,
+                topLeft = androidx.compose.ui.geometry.Offset(inset, inset), size = box,
+                style = androidx.compose.ui.graphics.drawscope.Stroke(stroke),
+            )
+            drawArc(
+                androidx.compose.ui.graphics.Brush.sweepGradient(listOf(Palette.PurpleDeep, Palette.Blue, Palette.Cyan, Palette.PurpleDeep)),
+                -90f, 360f * sweep, useCenter = false,
+                topLeft = androidx.compose.ui.geometry.Offset(inset, inset), size = box,
+                style = androidx.compose.ui.graphics.drawscope.Stroke(stroke, cap = androidx.compose.ui.graphics.StrokeCap.Round),
+            )
+        }
+        Text("${(sweep * 100).roundToInt()}%", style = Type.Display.copy(fontSize = 44.sp))
+    }
+}
