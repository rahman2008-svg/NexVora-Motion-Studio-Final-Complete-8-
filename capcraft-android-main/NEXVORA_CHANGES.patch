+        modifier.fillMaxHeight().clip(shape)
+            .then(if (filled) Modifier.background(Palette.PurpleBrush) else Modifier.background(Palette.Card).border(1.dp, Palette.Divider, shape))
+            .clickable(onClick = onClick).padding(horizontal = 8.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.Center,
+    ) {
+        Glyph(icon, if (filled) Color.White else Palette.Cyan, size = 30.dp)
+        Spacer(Modifier.height(8.dp))
+        Text(title, style = ink(15f, FontWeight.SemiBold, Color.White), maxLines = 1)
+        Text(subtitle, style = ink(12f, color = if (filled) Color(0xFFE3D8FF) else Home.Muted), maxLines = 1)
+    }
+}
