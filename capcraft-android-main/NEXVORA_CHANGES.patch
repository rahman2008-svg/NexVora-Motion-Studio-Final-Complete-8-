+/** A project as a card: its cover with the length on it, its name, and its size and age. Ticked is null outside Select. */
+@Composable
+private fun ProjectCard(p: ProjectSummary, ticked: Boolean?, onOpen: () -> Unit, onMenu: () -> Unit, modifier: Modifier = Modifier) {
+    val cover = rememberCover(p)
+    val shape = RoundedCornerShape(16.dp)
+    Column(
+        modifier.clip(shape).background(Palette.Card)
+            .border(if (ticked == true) 2.dp else 1.dp, if (ticked == true) Palette.Accent else Palette.Divider, shape)
+            .clickable(onClick = onOpen),
+    ) {
+        Box(Modifier.fillMaxWidth().aspectRatio(1.5f).background(Home.Tile), contentAlignment = Alignment.Center) {
+            if (cover != null) {
+                Image(cover.asImageBitmap(), contentDescription = null, contentScale = ContentScale.Crop, modifier = Modifier.fillMaxSize())
+            } else {
+                Glyph(LucideIcons.Film, Home.Muted, size = 28.dp)
+            }
+            if (!isPhoto(p)) {
+                Text(
+                    clock(p.durationUs),
+                    style = ink(11f, FontWeight.Medium, Color.White),
+                    modifier = Modifier.align(Alignment.BottomEnd).padding(6.dp).clip(RoundedCornerShape(6.dp))
+                        .background(Color(0xB3000000)).padding(horizontal = 6.dp, vertical = 2.dp),
+                )
+            }
+            if (ticked != null) {
+                Box(
+                    Modifier.align(Alignment.TopStart).padding(8.dp).size(22.dp).clip(CircleShape)
+                        .background(if (ticked) Palette.Accent else Color(0x66000000))
+                        .border(1.5.dp, if (ticked) Palette.Accent else Color.White, CircleShape),
+                    contentAlignment = Alignment.Center,
+                ) { if (ticked) Glyph(LucideIcons.Check, Palette.OnAccent, size = 14.dp) }
+            }
+        }
+        Row(Modifier.padding(start = 10.dp, top = 8.dp, bottom = 8.dp, end = 2.dp), verticalAlignment = Alignment.CenterVertically) {
+            Column(Modifier.weight(1f)) {
+                Text(p.name.ifBlank { "Untitled" }, style = ink(14f, FontWeight.SemiBold), maxLines = 1, overflow = TextOverflow.Ellipsis)
