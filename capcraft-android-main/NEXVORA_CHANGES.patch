++++++++++++++        if (action != null && onAction != null) {
++++++++++++++            Text(
++++++++++++++                action,
++++++++++++++                style = Type.Small.copy(color = Palette.Accent),
++++++++++++++                modifier = Modifier.clip(NexShape.Chip).clickable(role = Role.Button, onClick = onAction).padding(horizontal = 8.dp, vertical = 6.dp),
++++++++++++++            )
++++++++++++++        }
++++++++++++++    }
++++++++++++++}
