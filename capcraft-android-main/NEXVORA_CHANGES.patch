+/** The mark of a finished export: a glowing ring with a tick in it, which settles in when it first shows. */
+@Composable
+private fun SuccessEmblem(modifier: Modifier) {
+    var shown by remember { mutableStateOf(false) }
+    LaunchedEffect(Unit) { shown = true }
+    val scale by androidx.compose.animation.core.animateFloatAsState(
+        if (shown) 1f else 0.7f,
+        androidx.compose.animation.core.spring(dampingRatio = 0.6f, stiffness = 300f),
