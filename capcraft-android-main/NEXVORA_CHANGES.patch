+/** A tool on Home: its icon in a colour, its name under it, on a card. */
+@Composable
+private fun ToolTile(label: String, icon: ImageVector, tint: Color, modifier: Modifier, onClick: () -> Unit) {
+    val shape = RoundedCornerShape(16.dp)
