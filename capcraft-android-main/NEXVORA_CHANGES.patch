++++
++++/** Remembers that the welcome pages need not be shown again. */
++++fun markWelcomeSeen(context: Context) {
++++    context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putBoolean(SEEN, true).apply()
