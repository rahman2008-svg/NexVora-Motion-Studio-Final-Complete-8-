+++            .padding(horizontal = 20.dp, vertical = 10.dp),
+++        contentAlignment = Alignment.Center,
+++    ) {
+++        Text(
+++            text,
+++            style = Type.BodyStrong.copy(color = if (enabled) Palette.Text else Palette.Disabled, textAlign = TextAlign.Center),
+++            maxLines = 1,
+++        )
+++    }
+++}
