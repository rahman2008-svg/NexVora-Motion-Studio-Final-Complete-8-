+/** The hero's clapperboard in an orbit ring, drawn in the app's own colours. */
+@Composable
+private fun ClapperArt(modifier: Modifier) {
+    Canvas(modifier) {
+        val w = size.width
+        val h = size.height
+        val ring = Brush.linearGradient(listOf(Palette.Cyan, Palette.Accent, Palette.Blue))
+        drawOval(ring, Offset(w * 0.04f, h * 0.58f), Size(w * 0.92f, h * 0.34f), style = androidx.compose.ui.graphics.drawscope.Stroke(3.dp.toPx()))
+        rotate(-9f, Offset(w * 0.5f, h * 0.5f)) {
+            val bx = w * 0.2f
+            val by = h * 0.36f
+            val bw = w * 0.6f
+            val bh = h * 0.40f
+            val corner = CornerRadius(10.dp.toPx())
+            drawRoundRect(Brush.linearGradient(listOf(Color(0xFF4A2BD8), Color(0xFF1B1468))), Offset(bx, by), Size(bw, bh), corner)
+            drawRoundRect(Color(0x66FFFFFF), Offset(bx, by), Size(bw, bh), corner, style = androidx.compose.ui.graphics.drawscope.Stroke(1.5.dp.toPx()))
+            // the clapper bar, striped
+            val barH = h * 0.14f
+            val barTop = by - barH - 3.dp.toPx()
+            drawRoundRect(Color(0xFF12103A), Offset(bx, barTop), Size(bw, barH), CornerRadius(6.dp.toPx()))
+            val stripe = bw / 6f
+            for (i in 0 until 6 step 2) {
+                val path = androidx.compose.ui.graphics.Path().apply {
+                    moveTo(bx + i * stripe + stripe * 0.35f, barTop)
+                    lineTo(bx + (i + 1) * stripe + stripe * 0.35f, barTop)
+                    lineTo(bx + (i + 1) * stripe - stripe * 0.1f, barTop + barH)
+                    lineTo(bx + i * stripe - stripe * 0.1f, barTop + barH)
+                    close()
+                }
+                drawPath(path, Color.White)
+            }
+            // the play mark
+            val cx = bx + bw / 2f
+            val cy = by + bh / 2f
+            val r = bh * 0.28f
+            val play = androidx.compose.ui.graphics.Path().apply {
+                moveTo(cx - r * 0.6f, cy - r)
+                lineTo(cx + r, cy)
+                lineTo(cx - r * 0.6f, cy + r)
+                close()
+            }
